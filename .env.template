# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/helpkinmap
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpkinmap
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# Redis (for sessions and real-time features)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth - Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username

# Email (for invitations and notifications)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@helpkinmap.org
EMAIL_FROM_NAME=Help Kin Map

# Alternative: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# File Storage
STORAGE_PROVIDER=local
# Options: local, s3, gcs
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
# 10MB in bytes

# AWS S3 (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=helpkinmap-uploads

# Google Cloud Storage (if using GCS)
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEYFILE_PATH=

# Maps & Geolocation
MAPBOX_TOKEN=your_mapbox_token_optional
GOOGLE_MAPS_API_KEY=your_google_maps_key_optional

# Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@helpkinmap.org

# Security
SESSION_SECRET=your_session_secret_change_this
CORS_ORIGIN=http://localhost:3000,https://helpkinmap.org
RATE_LIMIT_WINDOW=15
# minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_2FA=false
ENABLE_PUBLIC_REQUESTS=true
MAINTENANCE_MODE=false

# Chat & Real-time
SOCKET_IO_PATH=/socket.io
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# Moderation
ENABLE_AUTO_MODERATION=false
MODERATION_API_KEY=

# Backups
BACKUP_SCHEDULE=0 2 * * *
# Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Development Tools
ENABLE_SWAGGER=true
ENABLE_GRAPHQL_PLAYGROUND=false
